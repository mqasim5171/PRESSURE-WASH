{
  "name": "horizon-cms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + Express + MySQL backend and admin CMS API for the Horizon Solar & Exterior Care website. Designed to run on Hostinger Business managed hosting (no VPS/Docker required).",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:migrate": "node src/scripts/migrateAdditive.js",
    "db:seed": "node src/scripts/seedContent.js",
    "db:seed-admin": "node src/scripts/seedAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "sharp": "^0.35.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}

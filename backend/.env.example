# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=production

# Public URL of the site (used for CORS + cookie settings). In production
# this is your real domain; the API, /admin and the public site all run
# from this same origin.
APP_URL=https://yourdomain.com.au

# Port Hostinger assigns to the Node.js Web App. Hostinger sets PORT
# automatically for you in most setups - only override this for local dev.
PORT=3001

# --- Hostinger Managed MySQL ---------------------------------------------
# Found in hPanel > Databases > MySQL Databases after creating a database.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Secrets ---------------------------------------------------------------
# Generate strong random values for both, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# --- Initial admin account --------------------------------------------------
# Only used the very first time the app boots against an empty admin_users
# table. Change the password from Admin > Account after your first login;
# these env vars are not read again afterwards.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123

# --- Uploaded media ----------------------------------------------------------
# Absolute path to a persistent directory Hostinger will not wipe between
# deploys. Defaults to backend/uploads if unset - fine as long as your
# Hostinger deployment doesn't replace the whole app directory on redeploy;
# set this to a dedicated persistent storage path if it does.
UPLOAD_DIR=
